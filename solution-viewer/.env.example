# Copy to .env.local (or let `bin/pg init` write it for you).
#
# Shared local postgres managed by bin/pg — same cluster for every checkout.
# Run `bin/pg url` to get the exact value.
DATABASE_URL=postgresql://<user>@localhost:15432/solution_viewer

# Neon (production) looks like:
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require
