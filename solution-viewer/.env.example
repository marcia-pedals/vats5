# Copy to .env.local (or let `bin/pg init` write it for you).
#
# Local postgres managed by bin/pg — the port is derived from the checkout path,
# so run `bin/pg url` to get the exact value for this checkout.
DATABASE_URL=postgresql://<user>@localhost:<port>/solution_viewer

# Neon (production) looks like:
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require
