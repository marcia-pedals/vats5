+/****************************************************************************/
+/*                                                                          */
+/*  Concorde LP interface (see lp.h) on top of the HiGHS C API.             */
+/*                                                                          */
+/*  Basis statuses in CClp_info / CClp_warmstart are stored as chars:       */
+/*  columns '0' nonbasic at lower, '1' basic, '2' nonbasic at upper,        */
+/*  '3' nonbasic free; rows '0' nonbasic (constraint tight, "active" in     */
+/*  Concorde's terms), '1' basic.                                           */
+/*                                                                          */
+/****************************************************************************/
+
+#include "machdefs.h"
+#include "util.h"
+#include "macrorus.h"
+#include "lp.h"
+#include "tsp.h"
+#include "interfaces/highs_c_api.h"
+
+#define HIGHS_INFINITY (1e30)
+#define HIGHS_ITER_UNLIMITED (2147483647)
+
+#define CSTAT_LOWER '0'
+#define CSTAT_BASIC '1'
+#define CSTAT_UPPER '2'
+#define CSTAT_FREE  '3'
+#define RSTAT_ACTIVE '0'
+#define RSTAT_BASIC  '1'
+
+struct CClp {
+    void *h;
+};
+
+struct CClp_warmstart {
+    int nstruct;
+    int nrows;
+    char *cstat;
+    char *rstat;
+};
+
+struct CClp_info {
+    int nstruct;
+    int nrows;
+    char *cstat;
+    char *rstat;
+};
+
+#define SOLVER_WARMSTART_NAME "HIGH"
+
+static int
+    new_highs (CClp *lp),
+    sense_to_bounds (char sense, double rhs, double *lower, double *upper),
+    run_simplex (CClp *lp, int strategy, int iteration_limit, int *model_status),
+    row_nonbasic_status (CClp *lp, int nrows, HighsInt *row_status);
+
+static void
+    init_warmstart (CClp_warmstart *w);
+
+static int new_highs (CClp *lp)
+{
+    if (lp->h) {
+        Highs_destroy (lp->h);
+        lp->h = (void *) NULL;
+    }
+    lp->h = Highs_create ();
+    if (!lp->h) {
+        fprintf (stderr, "Highs_create failed\n");
+        return 1;
+    }
+    Highs_setBoolOptionValue (lp->h, "output_flag", 0);
+    Highs_setStringOptionValue (lp->h, "presolve", "off");
+    Highs_setStringOptionValue (lp->h, "solver", "simplex");
+    Highs_setIntOptionValue (lp->h, "threads", 1);
+    Highs_setIntOptionValue (lp->h, "simplex_strategy", 1);
+    return 0;
+}
+
+static int sense_to_bounds (char sense, double rhs, double *lower,
+        double *upper)
+{
+    switch (sense) {
+    case 'E': *lower = rhs;             *upper = rhs;            return 0;
+    case 'L': *lower = -HIGHS_INFINITY; *upper = rhs;            return 0;
+    case 'G': *lower = rhs;             *upper = HIGHS_INFINITY; return 0;
+    default:
+        fprintf (stderr, "unknown row sense %c\n", sense);
+        return 1;
+    }
+}
+
+int CClp_init (CClp **lp)
+{
+    CClp_free (lp);
+    (*lp) = CC_SAFE_MALLOC (1, CClp);
+    if ((*lp) == (CClp *) NULL) {
+        fprintf (stderr, "Out of memory in CClp_init\n");
+        return 1;
+    }
+    (*lp)->h = (void *) NULL;
+    return 0;
+}
+
+int CClp_force_perturb (CClp *lp)
+{
+    if (!lp) {
+        fprintf (stderr, "CClp_force_perturb called without an lp\n");
+        return 1;
+    }
+    return 0;
+}
+
+int CClp_tune_small (CClp *lp)
+{
+    if (!lp) {
+        fprintf (stderr, "CClp_tune_small called without an LP\n");
+        return 1;
+    }
+    return 0;
+}
+
+int CClp_disable_presolve (CClp *lp)
+{
+    if (!lp) {
+        fprintf (stderr, "CClp_disable_presolve called without an LP\n");
+        return 1;
+    }
+    return 0;
+}
+
+void CClp_free (CClp **lp)
+{
+    if (*lp) {
+        if ((*lp)->h) Highs_destroy ((*lp)->h);
+        CC_FREE (*lp, CClp);
+    }
+}
+
+void CClp_freelp (CClp **lp)
+{
+    if (*lp) {
+        if ((*lp)->h) Highs_destroy ((*lp)->h);
+        (*lp)->h = (void *) NULL;
+    }
+}
+
+int CClp_loadlp (CClp *lp, const char *name, int ncols, int nrows,
