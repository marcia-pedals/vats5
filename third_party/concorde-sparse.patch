+}
+
+int CClp_delete_set_of_columns (CClp *lp, int *delstat)
+{
+    int rval = 0, i, j, ccnt, delcnt = 0;
+    HighsInt *dellist = (HighsInt *) NULL;
+
+    ccnt = Highs_getNumCol (lp->h);
+    for (i = 0; i < ccnt; i++) {
+        if (delstat[i]) delcnt++;
+    }
+    if (delcnt == 0) {
+        fprintf (stderr, "delete_set_of_columns with no deleted columns\n");
+        return 0;
+    }
+    dellist = CC_SAFE_MALLOC (delcnt, HighsInt);
+    if (!dellist) {
+        fprintf (stderr, "out of memory in delete_set_of_columns\n");
+        return 1;
+    }
+    for (i = 0, j = 0; i < ccnt; i++) {
+        if (delstat[i]) dellist[j++] = i;
+    }
+    if (Highs_deleteColsBySet (lp->h, delcnt, dellist) == kHighsStatusError) {
+        fprintf (stderr, "Highs_deleteColsBySet failed\n");
+        rval = 1;
