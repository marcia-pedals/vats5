+    for (i = 0; i < ncols; i++) nz += matcnt[i];
+
+    rlower = CC_SAFE_MALLOC (nrows + 1, double);
+    rupper = CC_SAFE_MALLOC (nrows + 1, double);
+    astart = CC_SAFE_MALLOC (ncols + 1, HighsInt);
+    aindex = CC_SAFE_MALLOC (nz + 1, HighsInt);
+    avalue = CC_SAFE_MALLOC (nz + 1, double);
+    if (!rlower || !rupper || !astart || !aindex || !avalue) {
