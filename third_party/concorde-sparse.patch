+/* Warm start for graphs where the fractional matching has no basic solution
+   in the sense of fmatch.c (a tree plus one odd circuit per component).
+   This is the case for bipartite graphs, where the optimal fractional
+   2-matching is an integral 2-factor; the cycles of that 2-factor give a
+   basis directly: in each cycle every edge but one is basic (at value 1),
+   the remaining edge is nonbasic at its upper bound, and the degree row of
+   one node of the cycle has a basic slack.  Leaves lp->warmstart unset if
+   the matching turns out not to be integral. */
+static int first_lp_2factor_warmstart (CCtsp_lp *lp, int ncount, int ecount,
+        int *elist, int *elen, int silent, CCrandstate *rstate)
+{
+    double v;
+    int *match = (int *) NULL;
+    int *madj  = (int *) NULL;
+    int *mdeg  = (int *) NULL;
+    int *mark  = (int *) NULL;
+    int i, a, b, e, cur, prev, next, start, ncycles = 0, rval = 0;
+    CClp_info *info = (CClp_info *) NULL;
+
+    match = CC_SAFE_MALLOC ((6 * ncount) + 1, int);
+    madj  = CC_SAFE_MALLOC (2 * ncount, int);
+    mdeg  = CC_SAFE_MALLOC (ncount, int);
+    mark  = CC_SAFE_MALLOC (ncount, int);
+    if (!match || !madj || !mdeg || !mark) {
+        fprintf (stderr, "out of memory in first_lp_2factor_warmstart\n");
+        rval = 1; goto CLEANUP;
+    }
+
+    rval = CCfmatch_fractional_2match (ncount, ecount, elist, elen,
+            (CCdatagroup *) NULL, &v, match, (int *) NULL, (int *) NULL, 0,
+            silent, rstate);
+    if (rval) {
+        fprintf (stderr, "Fractional matching without basis failed too\n");
+        rval = 0; goto CLEANUP;
+    }
+
+    for (i = 0; i < ncount; i++) {
+        mdeg[i] = 0;
+        mark[i] = 0;
+    }
+    for (i = 0; i <= 6*ncount && match[i] > -1; i += 3) {
+        if (match[i+2] != 2) {
+            printf ("Fractional matching is not integral, no warmstart\n");
+            fflush (stdout);
+            goto CLEANUP;
+        }
+        a = match[i];
+        b = match[i+1];
+        if (mdeg[a] >= 2 || mdeg[b] >= 2) {
+            fprintf (stderr, "2-factor has a node of degree > 2\n");
+            goto CLEANUP;
+        }
+        madj[2*a + mdeg[a]] = b; mdeg[a]++;
+        madj[2*b + mdeg[b]] = a; mdeg[b]++;
+    }
+    for (i = 0; i < ncount; i++) {
+        if (mdeg[i] != 2) {
+            fprintf (stderr, "2-factor has a node of degree %d\n", mdeg[i]);
+            goto CLEANUP;
+        }
+    }
+
+    rval = CClp_create_info (&info, ncount, ecount);
+    if (rval) {
+        fprintf (stderr, "CClp_create_info failed\n");
+        goto CLEANUP;
+    }
+    for (i = 0; i < ncount; i++) {
+        CClp_set_row_active (info, i);
+    }
+    for (i = 0; i < ecount; i++) {
+        CClp_set_col_inactive (info, i);
+    }
+
+    for (start = 0; start < ncount; start++) {
+        if (mark[start]) continue;
+        CClp_set_row_inactive (info, start);
+        ncycles++;
+        prev = -1;
+        cur = start;
+        do {
+            mark[cur] = 1;
+            next = madj[2*cur];
+            if (next == prev && madj[2*cur + 1] != prev) {
+                next = madj[2*cur + 1];
+            }
+            e = CCtsp_find_edge (&lp->graph, cur, next);
+            if (e < 0) {
+                fprintf (stderr, "2-factor edge %d,%d not in edgelist\n",
+                         cur, next);
+                CClp_free_info (&info);
+                goto CLEANUP;
+            }
+            if (next == start) {
+                CClp_set_col_upper (info, e);
+            } else {
+                CClp_set_col_active (info, e);
+            }
+            prev = cur;
+            cur = next;
+        } while (cur != start);
+    }
+
+    rval = CClp_build_warmstart (&(lp->warmstart), info);
+    if (rval) {
+        fprintf (stderr, "CClp_build_warmstart failed\n");
+        goto CLEANUP;
+    }
+    if (!silent) {
+        printf ("2-factor warmstart: %d cycles, value %.1f\n", ncycles, v);
+        fflush (stdout);
+    }
+
+CLEANUP:
+
+    CC_IFFREE (match, int);
+    CC_IFFREE (madj, int);
+    CC_IFFREE (mdeg, int);
+    CC_IFFREE (mark, int);
+    CClp_free_info (&info);
+    return rval;
+}
