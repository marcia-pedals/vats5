+/* In a bipartite LP graph, adding t to the duals on one side and
+   subtracting t on the other changes no reduced cost, and when both sides of
+   a component have the same size it changes no dual objective either.  The
+   LP solver may return duals far along that free direction (they are then
+   huge with opposite signs), and their sum can overflow the exact
+   arithmetic below.  Shift each component so that both sides have the same
+   mean; the bound and the reduced costs are unaffected. */
+static void balance_bipartite_duals (CCtsp_lp *lp, double *node_pi)
+{
+    int ncount = lp->graph.ncount;
+    int ecount = lp->graph.ecount;
+    int i, j, k, a, b, head, tail, ncomp = 0;
+    int *start = (int *) NULL, *nbr = (int *) NULL, *color = (int *) NULL;
+    int *queue = (int *) NULL, *fill = (int *) NULL;
+    double maxshift = 0.0, t, sum0, sum1;
+    int n0, n1;
+
+    start = CC_SAFE_MALLOC (ncount + 1, int);
+    fill  = CC_SAFE_MALLOC (ncount + 1, int);
+    nbr   = CC_SAFE_MALLOC (2 * ecount + 1, int);
+    color = CC_SAFE_MALLOC (ncount, int);
+    queue = CC_SAFE_MALLOC (ncount, int);
+    if (!start || !fill || !nbr || !color || !queue) goto CLEANUP;
+
+    for (i = 0; i <= ncount; i++) start[i] = 0;
+    for (i = 0; i < ecount; i++) {
+        start[lp->graph.edges[i].ends[0] + 1]++;
+        start[lp->graph.edges[i].ends[1] + 1]++;
+    }
+    for (i = 0; i < ncount; i++) {
+        start[i + 1] += start[i];
+        fill[i] = start[i];
+    }
+    for (i = 0; i < ecount; i++) {
+        a = lp->graph.edges[i].ends[0];
+        b = lp->graph.edges[i].ends[1];
+        nbr[fill[a]++] = b;
+        nbr[fill[b]++] = a;
+    }
+    for (i = 0; i < ncount; i++) color[i] = -1;
+
+    for (i = 0; i < ncount; i++) {
+        if (color[i] != -1) continue;
+        head = tail = 0;
+        queue[tail++] = i;
+        color[i] = 0;
+        n0 = n1 = 0;
+        sum0 = sum1 = 0.0;
+        while (head < tail) {
+            a = queue[head++];
+            if (color[a] == 0) { n0++; sum0 += node_pi[a]; }
+            else               { n1++; sum1 += node_pi[a]; }
+            for (k = start[a]; k < start[a + 1]; k++) {
+                b = nbr[k];
+                if (color[b] == -1) {
+                    color[b] = 1 - color[a];
+                    queue[tail++] = b;
+                } else if (color[b] == color[a]) {
+                    goto CLEANUP;   /* odd cycle: not bipartite, no shift */
+                }
+            }
+        }
+        if (n0 != n1 || n0 == 0) continue;
+        t = (sum1 / n1 - sum0 / n0) / 2.0;
+        if (t > maxshift) maxshift = t;
+        if (-t > maxshift) maxshift = -t;
+        for (j = 0; j < tail; j++) {
+            a = queue[j];
+            if (color[a] == 0) node_pi[a] += t;
+            else               node_pi[a] -= t;
+        }
+        ncomp++;
+    }
+    if (ncomp > 0) {
+        printf ("Balanced bipartite duals in %d components, max shift %.1f\n",
+                ncomp, maxshift);
+        fflush (stdout);
+    }
+
+CLEANUP:
+
+    CC_IFFREE (start, int);
+    CC_IFFREE (fill, int);
+    CC_IFFREE (nbr, int);
+    CC_IFFREE (color, int);
+    CC_IFFREE (queue, int);
+}
