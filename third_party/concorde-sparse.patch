+int CClp_delete_row (CClp *lp, int i)
+{
+    HighsInt set[1];
+
+    set[0] = i;
+    if (Highs_deleteRowsBySet (lp->h, 1, set) == kHighsStatusError) {
+        fprintf (stderr, "Highs_deleteRowsBySet failed\n");
+        return 1;
+    }
+    return 0;
+}
+
+int CClp_delete_set_of_rows (CClp *lp, int *delstat)
+{
+    int rval = 0, i, j, rcnt, delcnt = 0;
+    HighsInt *dellist = (HighsInt *) NULL;
+
+    rcnt = Highs_getNumRow (lp->h);
+    for (i = 0; i < rcnt; i++) {
+        if (delstat[i]) delcnt++;
+    }
+    if (delcnt == 0) {
+        fprintf (stderr, "delete_set_of_rows with no deleted rows\n");
+        return 0;
+    }
+    dellist = CC_SAFE_MALLOC (delcnt, HighsInt);
+    if (!dellist) {
+        fprintf (stderr, "out of memory in delete_set_of_rows\n");
+        return 1;
+    }
+    for (i = 0, j = 0; i < rcnt; i++) {
+        if (delstat[i]) dellist[j++] = i;
+    }
+    if (Highs_deleteRowsBySet (lp->h, delcnt, dellist) == kHighsStatusError) {
+        fprintf (stderr, "Highs_deleteRowsBySet failed\n");
+        rval = 1;
+    }
+    CC_IFFREE (dellist, HighsInt);
+    return rval;
+}
