+int CClp_x (CClp *lp, double *x)
+{
+    if (Highs_getSolution (lp->h, x, (double *) NULL, (double *) NULL,
+                           (double *) NULL) == kHighsStatusError) {
+        fprintf (stderr, "Highs_getSolution (x) failed\n");
+        return 1;
+    }
+    return 0;
+}
+
+int CClp_rc (CClp *lp, double *rc)
+{
+    if (Highs_getSolution (lp->h, (double *) NULL, rc, (double *) NULL,
+                           (double *) NULL) == kHighsStatusError) {
+        fprintf (stderr, "Highs_getSolution (rc) failed\n");
+        return 1;
+    }
+    return 0;
+}
+
+int CClp_pi (CClp *lp, double *pi)
+{
+    HighsInt has_ray = 0;
+    int i, nrows;
+
+    if (Highs_getModelStatus (lp->h) == kHighsModelStatusInfeasible) {
+        /* Farkas certificate, in the same orientation as the duals: a
+           combination of the rows proving infeasibility. */
+        if (Highs_getDualRay (lp->h, &has_ray, pi) == kHighsStatusError ||
+            !has_ray) {
+            fprintf (stderr, "Highs_getDualRay failed\n");
+            return 1;
+        }
+        (void) i; (void) nrows;
+        return 0;
+    }
+    if (Highs_getSolution (lp->h, (double *) NULL, (double *) NULL,
+                           (double *) NULL, pi) == kHighsStatusError) {
+        fprintf (stderr, "Highs_getSolution (pi) failed\n");
+        return 1;
+    }
+    return 0;
+}
+
+int CClp_objval (CClp *lp, double *obj)
+{
+    *obj = Highs_getObjectiveValue (lp->h);
+    return 0;
+}
