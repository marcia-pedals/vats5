+
+/* Sort every adjacency list by neighbor so that sparse_edgelen (edgelen.c)
+   can binary search.  Must be called whenever the lists are (re)built. */
+static int sort_sparse_adj (int ncount, CCdatagroup *dat)
+{
+    int i, j, deg, maxdeg = 0;
+    sparse_adjpair *buf = (sparse_adjpair *) NULL;
