+}
+
+int CClp_setbnd (CClp *lp, int col, char lower_or_upper, double bnd)
+{
+    HighsInt num_col, num_nz;
+    double cost, lower, upper;
+
+    if (Highs_getColsByRange (lp->h, col, col, &num_col, &cost, &lower,
+                              &upper, &num_nz, (HighsInt *) NULL,
+                              (HighsInt *) NULL, (double *) NULL)
+            == kHighsStatusError) {
+        fprintf (stderr, "Highs_getColsByRange failed\n");
+        return 1;
+    }
+    if (lower_or_upper == 'L') {
+        lower = bnd;
+    } else if (lower_or_upper == 'U') {
+        upper = bnd;
+    } else {
+        fprintf (stderr, "CClp_setbnd: bad bound type %c\n", lower_or_upper);
+        return 1;
+    }
+    if (Highs_changeColBounds (lp->h, col, lower, upper) == kHighsStatusError) {
+        fprintf (stderr, "Highs_changeColBounds failed\n");
+        return 1;
+    }
+    return 0;
+}
+
+/* A nonbasic row's slack sits at the finite side of its bounds. */
+static int row_nonbasic_status (CClp *lp, int nrows, HighsInt *row_status)
+{
+    int rval = 0, i;
+    HighsInt num_row, num_nz;
+    double *lower = (double *) NULL, *upper = (double *) NULL;
+
+    if (nrows == 0) return 0;
+    lower = CC_SAFE_MALLOC (nrows, double);
+    upper = CC_SAFE_MALLOC (nrows, double);
+    if (!lower || !upper) {
+        fprintf (stderr, "out of memory in row_nonbasic_status\n");
+        rval = 1; goto CLEANUP;
+    }
+    if (Highs_getRowsByRange (lp->h, 0, nrows - 1, &num_row, lower, upper,
+                              &num_nz, (HighsInt *) NULL, (HighsInt *) NULL,
+                              (double *) NULL) == kHighsStatusError) {
+        fprintf (stderr, "Highs_getRowsByRange failed\n");
+        rval = 1; goto CLEANUP;
+    }
+    for (i = 0; i < nrows; i++) {
+        if (row_status[i] != kHighsBasisStatusBasic) {
+            row_status[i] = (lower[i] <= -HIGHS_INFINITY / 2)
+                                ? kHighsBasisStatusUpper
+                                : kHighsBasisStatusLower;
+        }
+    }
+
+CLEANUP:
+
+    CC_IFFREE (lower, double);
+    CC_IFFREE (upper, double);
+    return rval;
+}
+
+int CClp_get_warmstart (CClp *lp, CClp_warmstart **w)
+{
+    int rval = 0, i;
+    HighsInt *cs = (HighsInt *) NULL, *rs = (HighsInt *) NULL;
+
+    CClp_free_warmstart (w);
+    (*w) = CC_SAFE_MALLOC (1, CClp_warmstart);
+    if (!(*w)) {
+        fprintf (stderr, "Out of memory in CClp_get_warmstart\n");
+        rval = 1; goto CLEANUP;
+    }
+    init_warmstart (*w);
+    (*w)->nstruct = Highs_getNumCol (lp->h);
+    (*w)->nrows = Highs_getNumRow (lp->h);
+    (*w)->cstat = CC_SAFE_MALLOC ((*w)->nstruct + 1, char);
+    (*w)->rstat = CC_SAFE_MALLOC ((*w)->nrows + 1, char);
+    cs = CC_SAFE_MALLOC ((*w)->nstruct + 1, HighsInt);
+    rs = CC_SAFE_MALLOC ((*w)->nrows + 1, HighsInt);
+    if (!(*w)->cstat || !(*w)->rstat || !cs || !rs) {
+        fprintf (stderr, "out of memory in CClp_get_warmstart\n");
+        rval = 1; goto CLEANUP;
+    }
+    if (Highs_getBasis (lp->h, cs, rs) == kHighsStatusError) {
+        fprintf (stderr, "Highs_getBasis failed\n");
+        rval = 1; goto CLEANUP;
+    }
+    for (i = 0; i < (*w)->nstruct; i++) {
+        switch (cs[i]) {
+        case kHighsBasisStatusBasic: (*w)->cstat[i] = CSTAT_BASIC; break;
+        case kHighsBasisStatusUpper: (*w)->cstat[i] = CSTAT_UPPER; break;
+        case kHighsBasisStatusZero:  (*w)->cstat[i] = CSTAT_FREE;  break;
+        default:                     (*w)->cstat[i] = CSTAT_LOWER; break;
+        }
+    }
+    for (i = 0; i < (*w)->nrows; i++) {
+        (*w)->rstat[i] = (rs[i] == kHighsBasisStatusBasic) ? RSTAT_BASIC
+                                                           : RSTAT_ACTIVE;
+    }
+
+CLEANUP:
+
+    CC_IFFREE (cs, HighsInt);
+    CC_IFFREE (rs, HighsInt);
+    if (rval) CClp_free_warmstart (w);
+    return rval;
+}
+
+int CClp_load_warmstart (CClp *lp, CClp_warmstart *w)
+{
+    int rval = 0, i, ncols, nrows;
+    HighsInt *cs = (HighsInt *) NULL, *rs = (HighsInt *) NULL;
+
+    if (!w->cstat || !w->rstat) {
+        fprintf (stderr, "WARNING: no basis in call to load_warmstart\n");
+        return 0;
+    }
+    ncols = Highs_getNumCol (lp->h);
+    nrows = Highs_getNumRow (lp->h);
+    if (w->nstruct != ncols || w->nrows != nrows) {
+        fprintf (stderr, "warmstart size (%d x %d) does not match LP (%d x %d)\n",
+                 w->nrows, w->nstruct, nrows, ncols);
+        return 1;
+    }
+    cs = CC_SAFE_MALLOC (ncols + 1, HighsInt);
+    rs = CC_SAFE_MALLOC (nrows + 1, HighsInt);
+    if (!cs || !rs) {
+        fprintf (stderr, "out of memory in CClp_load_warmstart\n");
+        rval = 1; goto CLEANUP;
+    }
+    for (i = 0; i < ncols; i++) {
+        switch (w->cstat[i]) {
+        case CSTAT_BASIC: cs[i] = kHighsBasisStatusBasic; break;
+        case CSTAT_UPPER: cs[i] = kHighsBasisStatusUpper; break;
+        case CSTAT_FREE:  cs[i] = kHighsBasisStatusZero;  break;
+        default:          cs[i] = kHighsBasisStatusLower; break;
+        }
+    }
+    for (i = 0; i < nrows; i++) {
+        rs[i] = (w->rstat[i] == RSTAT_BASIC) ? kHighsBasisStatusBasic
+                                             : kHighsBasisStatusLower;
+    }
+    rval = row_nonbasic_status (lp, nrows, rs);
+    if (rval) goto CLEANUP;
+    if (Highs_setBasis (lp->h, cs, rs) == kHighsStatusError) {
+        fprintf (stderr, "Highs_setBasis failed\n");
+        rval = 1; goto CLEANUP;
+    }
+
+CLEANUP:
+
+    CC_IFFREE (cs, HighsInt);
+    CC_IFFREE (rs, HighsInt);
+    return rval;
+}
+
+int CClp_build_warmstart (CClp_warmstart **w, CClp_info *i)
+{
+    int rval = 0, j;
+
+    CClp_free_warmstart (w);
+    (*w) = CC_SAFE_MALLOC (1, CClp_warmstart);
+    if (!(*w)) {
+        fprintf (stderr, "Out of memory in CClp_build_warmstart\n");
+        rval = 1; goto CLEANUP;
+    }
+    init_warmstart (*w);
+    (*w)->nstruct = i->nstruct;
+    (*w)->nrows = i->nrows;
+    if ((*w)->nstruct == 0 || (*w)->nrows == 0) {
+        fprintf (stderr, "No columns or rows in CClp_info\n");
+        rval = 1; goto CLEANUP;
+    }
+    (*w)->cstat = CC_SAFE_MALLOC ((*w)->nstruct, char);
+    (*w)->rstat = CC_SAFE_MALLOC ((*w)->nrows, char);
+    if (!(*w)->cstat || !(*w)->rstat) {
+        fprintf (stderr, "out of memory in CClp_build_warmstart\n");
+        rval = 1; goto CLEANUP;
+    }
+    for (j = 0; j < (*w)->nstruct; j++) (*w)->cstat[j] = i->cstat[j];
+    for (j = 0; j < (*w)->nrows; j++)   (*w)->rstat[j] = i->rstat[j];
+
+CLEANUP:
+
+    if (rval) CClp_free_warmstart (w);
+    return rval;
+}
+
+static void init_warmstart (CClp_warmstart *w)
+{
+    if (w) {
+        w->nstruct = 0;
+        w->nrows = 0;
+        w->cstat = (char *) NULL;
+        w->rstat = (char *) NULL;
+    }
+}
+
+void CClp_free_warmstart (CClp_warmstart **w)
+{
+    if (*w) {
+        CC_IFFREE ((*w)->cstat, char);
+        CC_IFFREE ((*w)->rstat, char);
+        CC_FREE (*w, CClp_warmstart);
+    }
+}
+
+int CClp_sread_warmstart (CC_SFILE *f, CClp_warmstart **w)
+{
+    int rval = 0, i, k, nstruct, nrows;
+    char name[5];
+
+    CClp_free_warmstart (w);
+    for (i = 0; i < 4; i++) {
+        if (CCutil_sread_char (f, &name[i])) { rval = 1; goto CLEANUP; }
+    }
+    name[4] = '\0';
+    if (strncmp (name, SOLVER_WARMSTART_NAME, 4)) {
+        fprintf (stderr, "warmstart for another solver (%s) ignored\n", name);
+        goto CLEANUP;
+    }
+    if (CCutil_sread_int (f, &nstruct)) goto CLEANUP;
+    if (CCutil_sread_int (f, &nrows)) goto CLEANUP;
+
+    (*w) = CC_SAFE_MALLOC (1, CClp_warmstart);
+    if (!(*w)) {
+        fprintf (stderr, "Out of memory in CClp_sread_warmstart\n");
+        rval = 1; goto CLEANUP;
+    }
+    init_warmstart (*w);
+    (*w)->cstat = CC_SAFE_MALLOC (nstruct, char);
+    (*w)->rstat = CC_SAFE_MALLOC (nrows, char);
+    if (!(*w)->cstat || !(*w)->rstat) {
+        fprintf (stderr, "out of memory in CClp_sread_warmstart\n");
+        rval = 1; goto CLEANUP;
+    }
+    for (i = 0; i < nstruct; i++) {
+        if (CCutil_sread_bits (f, &k, 2)) { rval = 1; goto CLEANUP; }
+        (*w)->cstat[i] = '0' + k;
+    }
+    for (i = 0; i < nrows; i++) {
+        if (CCutil_sread_bits (f, &k, 1)) { rval = 1; goto CLEANUP; }
+        (*w)->rstat[i] = '0' + k;
+    }
+    (*w)->nstruct = nstruct;
+    (*w)->nrows = nrows;
+
+CLEANUP:
+
+    if (rval) CClp_free_warmstart (w);
+    return rval;
+}
+
+int CClp_swrite_warmstart (CC_SFILE *f, CClp_warmstart *w)
+{
+    int i;
+    const char *name = SOLVER_WARMSTART_NAME;
+
+    for (i = 0; i < 4; i++) {
+        if (CCutil_swrite_char (f, name[i])) return 1;
+    }
+    if (CCutil_swrite_int (f, w->nstruct)) return 1;
+    if (CCutil_swrite_int (f, w->nrows)) return 1;
+    for (i = 0; i < w->nstruct; i++) {
+        if (CCutil_swrite_bits (f, w->cstat[i] - '0', 2)) return 1;
+    }
+    for (i = 0; i < w->nrows; i++) {
+        if (CCutil_swrite_bits (f, w->rstat[i] - '0', 1)) return 1;
+    }
+    return 0;
+}
+
+int CClp_get_info (CClp *lp, CClp_info **i)
+{
+    int rval = 0;
+    CClp_warmstart *w = (CClp_warmstart *) NULL;
+
+    CClp_free_info (i);
+    rval = CClp_get_warmstart (lp, &w);
+    if (rval) goto CLEANUP;
+
+    (*i) = CC_SAFE_MALLOC (1, CClp_info);
+    if (!(*i)) {
+        fprintf (stderr, "Out of memory in CClp_get_info\n");
+        rval = 1; goto CLEANUP;
+    }
+    (*i)->nstruct = w->nstruct;
+    (*i)->nrows = w->nrows;
+    (*i)->cstat = w->cstat;
+    (*i)->rstat = w->rstat;
+    w->cstat = (char *) NULL;
+    w->rstat = (char *) NULL;
+
+CLEANUP:
+
+    CClp_free_warmstart (&w);
+    return rval;
+}
+
+int CClp_create_info (CClp_info **i, int rcount, int ccount)
+{
+    int rval = 0, j;
+
+    CClp_free_info (i);
+    (*i) = CC_SAFE_MALLOC (1, CClp_info);
+    if (!(*i)) {
+        fprintf (stderr, "Out of memory in CClp_create_info\n");
+        rval = 1; goto CLEANUP;
+    }
+    (*i)->cstat = (char *) NULL;
+    (*i)->rstat = (char *) NULL;
+    (*i)->nstruct = ccount;
+    (*i)->nrows = rcount;
+    if (ccount == 0 || rcount == 0) {
+        fprintf (stderr, "No columns or rows in CClp_create_info\n");
+        rval = 1; goto CLEANUP;
+    }
+    (*i)->cstat = CC_SAFE_MALLOC (ccount, char);
+    (*i)->rstat = CC_SAFE_MALLOC (rcount, char);
+    if (!(*i)->cstat || !(*i)->rstat) {
+        fprintf (stderr, "out of memory in CClp_create_info\n");
+        rval = 1; goto CLEANUP;
+    }
+    for (j = 0; j < ccount; j++) (*i)->cstat[j] = CSTAT_LOWER;
+    for (j = 0; j < rcount; j++) (*i)->rstat[j] = RSTAT_ACTIVE;
+
+CLEANUP:
+
+    if (rval) CClp_free_info (i);
+    return rval;
+}
+
+int CClp_is_col_active (CClp_info *i, int c)
+{
+    if (c < 0 || c >= i->nstruct) return 0;
+    return i->cstat[c] == CSTAT_BASIC;
+}
+
+int CClp_is_row_active (CClp_info *i, int r)
+{
+    if (r < 0 || r >= i->nrows) return 0;
+    return i->rstat[r] == RSTAT_ACTIVE;
+}
+
+void CClp_set_col_active (CClp_info *i, int c)
+{
+    if (c >= 0 && c < i->nstruct) i->cstat[c] = CSTAT_BASIC;
+}
+
+void CClp_set_col_inactive (CClp_info *i, int c)
+{
+    if (c >= 0 && c < i->nstruct) i->cstat[c] = CSTAT_LOWER;
+}
+
+void CClp_set_col_upper (CClp_info *i, int c)
+{
+    if (c >= 0 && c < i->nstruct) i->cstat[c] = CSTAT_UPPER;
+}
+
+void CClp_set_row_active (CClp_info *i, int r)
+{
+    if (r >= 0 && r < i->nrows) i->rstat[r] = RSTAT_ACTIVE;
+}
+
+void CClp_set_row_inactive (CClp_info *i, int r)
+{
+    if (r >= 0 && r < i->nrows) i->rstat[r] = RSTAT_BASIC;
+}
+
+void CClp_free_info (CClp_info **i)
+{
+    if (*i) {
+        CC_IFFREE ((*i)->cstat, char);
+        CC_IFFREE ((*i)->rstat, char);
+        CC_FREE (*i, CClp_info);
+    }
+}
