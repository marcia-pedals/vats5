+/****************************************************************************/
+/*                                                                          */
+/*  Sparse-graph (CC_SPARSE norm) replacements for the tour and edge-set    */
+/*  construction above.  Everything here runs in O(m log m) for m sparse    */
+/*  edges and never enumerates the implicit complete graph.                 */
+/*                                                                          */
+/****************************************************************************/
+
+typedef struct sparse_pair {
+    int a;
+    int b;
+} sparse_pair;
+
+static int sparse_pair_cmp (const void *x, const void *y)
+{
+    const sparse_pair *p = (const sparse_pair *) x;
+    const sparse_pair *q = (const sparse_pair *) y;
+
+    if (p->a != q->a) return (p->a > q->a) - (p->a < q->a);
+    return (p->b > q->b) - (p->b < q->b);
+}
+
+/* Symmetric incidence lists.  A CC_SPARSE datagroup stores each edge only
+   under its smaller endpoint; here node i's neighbors and edge lengths are
+   nbr[start[i] .. start[i+1]-1] and len[...]. */
+static int sparse_incidence (int ncount, CCdatagroup *dat, int **p_start,
+        int **p_nbr, int **p_len)
+{
+    int rval = 0, i, j, k, m = dat->sparse_ecount;
+    int *start = (int *) NULL, *nbr = (int *) NULL, *len = (int *) NULL;
+    int *fill = (int *) NULL;
+
+    *p_start = (int *) NULL;
+    *p_nbr   = (int *) NULL;
+    *p_len   = (int *) NULL;
+
+    start = CC_SAFE_MALLOC (ncount + 1, int);
+    fill  = CC_SAFE_MALLOC (ncount + 1, int);
+    nbr   = CC_SAFE_MALLOC (2 * m + 1, int);
+    len   = CC_SAFE_MALLOC (2 * m + 1, int);
+    if (!start || !fill || !nbr || !len) {
+        fprintf (stderr, "out of memory in sparse_incidence\n");
+        rval = 1; goto CLEANUP;
+    }
+
+    for (i = 0; i <= ncount; i++) start[i] = 0;
+    for (i = 0; i < ncount; i++) {
+        for (j = 0; j < dat->degree[i]; j++) {
+            start[i + 1]++;
+            start[dat->adj[i][j] + 1]++;
+        }
+    }
+    for (i = 0; i < ncount; i++) {
+        start[i + 1] += start[i];
+        fill[i] = start[i];
+    }
+    for (i = 0; i < ncount; i++) {
+        for (j = 0; j < dat->degree[i]; j++) {
+            k = dat->adj[i][j];
+            nbr[fill[i]] = k;
+            len[fill[i]] = dat->len[i][j];
+            fill[i]++;
+            nbr[fill[k]] = i;
+            len[fill[k]] = dat->len[i][j];
+            fill[k]++;
+        }
+    }
+
+    *p_start = start;
+    *p_nbr   = nbr;
+    *p_len   = len;
+
+CLEANUP:
+
+    CC_IFFREE (fill, int);
+    if (rval) {
+        CC_IFFREE (start, int);
+        CC_IFFREE (nbr, int);
+        CC_IFFREE (len, int);
+    }
+    return rval;
+}
+
+/* The union over all nodes of each node's k cheapest incident edges, as an
+   undirected edge list without duplicates.  Public because the x-heuristic
+   in xtour.c needs the same candidate set. */
+int CCtsp_sparse_k_cheapest (int ncount, CCdatagroup *dat, int k,
+        int *ecount, int **elist, int **elen)
+{
+    int rval = 0, i, j, deg, maxdeg = 0, cnt = 0, uniq;
+    int *start = (int *) NULL, *nbr = (int *) NULL, *len = (int *) NULL;
+    int *perm = (int *) NULL;
+    sparse_pair *pairs = (sparse_pair *) NULL;
+
+    *ecount = 0;
+    *elist  = (int *) NULL;
+    *elen   = (int *) NULL;
+
+    rval = sparse_incidence (ncount, dat, &start, &nbr, &len);
+    if (rval) {
+        fprintf (stderr, "sparse_incidence failed\n"); goto CLEANUP;
+    }
+
+    for (i = 0; i < ncount; i++) {
+        deg = start[i + 1] - start[i];
+        if (deg > maxdeg) maxdeg = deg;
+    }
+
+    perm  = CC_SAFE_MALLOC (maxdeg + 1, int);
+    pairs = CC_SAFE_MALLOC ((size_t) k * ncount + 1, sparse_pair);
+    if (!perm || !pairs) {
+        fprintf (stderr, "out of memory in sparse_k_cheapest\n");
+        rval = 1; goto CLEANUP;
+    }
+
+    for (i = 0; i < ncount; i++) {
+        deg = start[i + 1] - start[i];
+        for (j = 0; j < deg; j++) perm[j] = j;
+        if (deg > k) {
+            CCutil_int_perm_quicksort (perm, len + start[i], deg);
+            deg = k;
+        }
+        for (j = 0; j < deg; j++) {
+            int other = nbr[start[i] + perm[j]];
+            pairs[cnt].a = (i < other) ? i : other;
+            pairs[cnt].b = (i < other) ? other : i;
+            cnt++;
+        }
+    }
+
+    qsort (pairs, cnt, sizeof (sparse_pair), sparse_pair_cmp);
+    uniq = 0;
+    for (i = 0; i < cnt; i++) {
+        if (i == 0 || pairs[i].a != pairs[i-1].a ||
+                      pairs[i].b != pairs[i-1].b) {
+            pairs[uniq++] = pairs[i];
+        }
+    }
+
+    *elist = CC_SAFE_MALLOC (2 * uniq + 1, int);
+    *elen  = CC_SAFE_MALLOC (uniq + 1, int);
+    if (!(*elist) || !(*elen)) {
+        fprintf (stderr, "out of memory in sparse_k_cheapest\n");
+        rval = 1; goto CLEANUP;
+    }
+    for (i = 0; i < uniq; i++) {
+        (*elist)[2*i]   = pairs[i].a;
+        (*elist)[2*i+1] = pairs[i].b;
+        (*elen)[i] = CCutil_dat_edgelen (pairs[i].a, pairs[i].b, dat);
+    }
+    *ecount = uniq;
+
+CLEANUP:
+
+    CC_IFFREE (start, int);
+    CC_IFFREE (nbr, int);
+    CC_IFFREE (len, int);
+    CC_IFFREE (perm, int);
+    CC_IFFREE (pairs, sparse_pair);
+    if (rval) {
+        CC_IFFREE (*elist, int);
+        CC_IFFREE (*elen, int);
+        *ecount = 0;
+    }
+    return rval;
+}
+
+static int sparse_uf_find (int *parent, int x)
+{
+    while (parent[x] != x) {
+        parent[x] = parent[parent[x]];
+        x = parent[x];
+    }
+    return x;
+}
+
+/* Greedy tour: scan the sparse edges by increasing length, keeping an edge
+   whenever both ends have degree < 2 and it does not close a cycle.  This
+   leaves a set of vertex-disjoint paths (isolated nodes are 1-node paths)
+   whose endpoints are then chained into a single cycle.  The chaining edges
+   are in general not sparse edges (they cost default_len), and Lin-Kernighan
+   removes them first since each removal gains about default_len. */
+static int sparse_greedy_tour (int ncount, CCdatagroup *dat, int *cyc)
+{
+    int rval = 0, i, e, a, b, ra, rb, m = 0, k = 0, nfrag = 0, istour;
+    int *elist = (int *) NULL, *elen = (int *) NULL, *perm = (int *) NULL;
+    int *parent = (int *) NULL, *deg = (int *) NULL, *tlist = (int *) NULL;
+    int *end1 = (int *) NULL, *end2 = (int *) NULL, *frag = (int *) NULL;
+
+    rval = CCutil_get_sparse_dat_edges (ncount, dat, &m, &elist, &elen);
+    if (rval) {
+        fprintf (stderr, "CCutil_get_sparse_dat_edges failed\n");
+        goto CLEANUP;
+    }
+
+    perm   = CC_SAFE_MALLOC (m + 1, int);
+    parent = CC_SAFE_MALLOC (ncount, int);
+    deg    = CC_SAFE_MALLOC (ncount, int);
+    tlist  = CC_SAFE_MALLOC (2 * ncount, int);
+    end1   = CC_SAFE_MALLOC (ncount, int);
+    end2   = CC_SAFE_MALLOC (ncount, int);
+    frag   = CC_SAFE_MALLOC (ncount, int);
+    if (!perm || !parent || !deg || !tlist || !end1 || !end2 || !frag) {
+        fprintf (stderr, "out of memory in sparse_greedy_tour\n");
+        rval = 1; goto CLEANUP;
+    }
+
+    for (i = 0; i < m; i++) perm[i] = i;
+    CCutil_int_perm_quicksort (perm, elen, m);
 
+    for (i = 0; i < ncount; i++) {
+        parent[i] = i;
+        deg[i] = 0;
+        end1[i] = end2[i] = -1;
+    }
+
+    for (e = 0; e < m; e++) {
+        i = perm[e];
+        a = elist[2*i];
+        b = elist[2*i+1];
+        if (a == b || deg[a] >= 2 || deg[b] >= 2) continue;
+        ra = sparse_uf_find (parent, a);
+        rb = sparse_uf_find (parent, b);
+        if (ra == rb) continue;
+        parent[ra] = rb;
+        deg[a]++;
+        deg[b]++;
+        tlist[2*k]   = a;
+        tlist[2*k+1] = b;
+        k++;
+    }
+
+    /* Path endpoints have degree < 2; an isolated node is both ends. */
+    for (i = 0; i < ncount; i++) {
+        if (deg[i] < 2) {
+            ra = sparse_uf_find (parent, i);
+            if (end1[ra] == -1) end1[ra] = i;
+            else                end2[ra] = i;
+        }
+    }
+    for (i = 0; i < ncount; i++) {
+        if (sparse_uf_find (parent, i) == i) {
+            if (end1[i] == -1) {
+                fprintf (stderr, "fragment without endpoints\n");
+                rval = 1; goto CLEANUP;
+            }
+            if (end2[i] == -1) end2[i] = end1[i];
+            frag[nfrag++] = i;
+        }
+    }
+
+    for (i = 0; i < nfrag; i++) {
+        tlist[2*k]   = end2[frag[i]];
+        tlist[2*k+1] = end1[frag[(i + 1) % nfrag]];
+        k++;
+    }
+    if (k != ncount) {
+        fprintf (stderr, "sparse_greedy_tour: %d edges for %d nodes\n",
+                 k, ncount);
+        rval = 1; goto CLEANUP;
+    }
+    printf ("Sparse greedy tour: %d path fragments joined\n", nfrag);
+    fflush (stdout);
+
+    rval = CCutil_edge_to_cycle (ncount, tlist, &istour, cyc);
+    if (rval) {
+        fprintf (stderr, "CCutil_edge_to_cycle failed\n"); goto CLEANUP;
+    }
+    if (!istour) {
+        fprintf (stderr, "sparse_greedy_tour did not build a tour\n");
+        rval = 1; goto CLEANUP;
+    }
+
+CLEANUP:
+
+    CC_IFFREE (elist, int);
+    CC_IFFREE (elen, int);
+    CC_IFFREE (perm, int);
+    CC_IFFREE (parent, int);
+    CC_IFFREE (deg, int);
+    CC_IFFREE (tlist, int);
+    CC_IFFREE (end1, int);
+    CC_IFFREE (end2, int);
+    CC_IFFREE (frag, int);
+    return rval;
+}
+
+#define SPARSE_LK_CANDIDATES 10
+
+/* find_good_tour for the CC_SPARSE norm: Lin-Kernighan on a candidate set of
