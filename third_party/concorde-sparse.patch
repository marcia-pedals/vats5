+}
+
+int CClp_getgoodlist (CClp *lp, int *goodlist, int *goodlen_p,
+        double *downpen, double *uppen)
+{
+    int rval = 0, i, j, ncols;
+    double *x = (double *) NULL;
+
+    *goodlen_p = 0;
+    ncols = Highs_getNumCol (lp->h);
+    x = CC_SAFE_MALLOC (ncols + 1, double);
+    if (!x) {
+        fprintf (stderr, "out of memory in CClp_getgoodlist\n");
+        rval = 1; goto CLEANUP;
+    }
+    rval = CClp_x (lp, x);
+    if (rval) goto CLEANUP;
+    for (i = 0, j = 0; i < ncols; i++) {
+        if (x[i] >= CCtsp_INTTOL && x[i] <= 1.0 - CCtsp_INTTOL) {
+            goodlist[j] = i;
+            downpen[j] = x[i];
+            uppen[j] = 1.0 - x[i];
+            j++;
+        }
+    }
+    *goodlen_p = j;
+
+CLEANUP:
+
+    CC_IFFREE (x, double);
+    return rval;
+}
+
+/* Strong branching by hand: for each candidate, bound the column to 0 and
+   to 1 in turn, run a limited dual simplex from the current basis, and
+   report the objective (or the upper bound if the LP is infeasible or
+   exceeds it).  The bounds and the basis are restored afterwards. */
+int CClp_strongbranch (CClp *lp, int *candidatelist, int ncand,
+        double *downpen, double *uppen, int iterations, double upperbound)
+{
+    int rval = 0, i, k, ncols, nrows, model_status;
+    HighsInt *cs = (HighsInt *) NULL, *rs = (HighsInt *) NULL;
+    HighsInt num_col, num_nz;
+    double cost, lower, upper, val;
+
+    ncols = Highs_getNumCol (lp->h);
+    nrows = Highs_getNumRow (lp->h);
+    cs = CC_SAFE_MALLOC (ncols + 1, HighsInt);
+    rs = CC_SAFE_MALLOC (nrows + 1, HighsInt);
+    if (!cs || !rs) {
+        fprintf (stderr, "out of memory in CClp_strongbranch\n");
+        rval = 1; goto CLEANUP;
+    }
+    if (Highs_getBasis (lp->h, cs, rs) == kHighsStatusError) {
+        fprintf (stderr, "Highs_getBasis failed\n");
+        rval = 1; goto CLEANUP;
+    }
+
+    for (i = 0; i < ncand; i++) {
+        int col = candidatelist[i];
+        if (Highs_getColsByRange (lp->h, col, col, &num_col, &cost, &lower,
+                                  &upper, &num_nz, (HighsInt *) NULL,
+                                  (HighsInt *) NULL, (double *) NULL)
+                == kHighsStatusError) {
+            fprintf (stderr, "Highs_getColsByRange failed\n");
+            rval = 1; goto CLEANUP;
+        }
+        for (k = 0; k < 2; k++) {
+            double *pen = (k == 0) ? &downpen[i] : &uppen[i];
+            if (k == 0) Highs_changeColBounds (lp->h, col, lower, 0.0);
+            else        Highs_changeColBounds (lp->h, col, 1.0, upper);
+            rval = run_simplex (lp, 1, iterations, &model_status);
+            if (rval) goto CLEANUP;
+            if (model_status == kHighsModelStatusInfeasible) {
+                val = upperbound;
+            } else {
+                val = Highs_getObjectiveValue (lp->h);
+                if (val > upperbound) val = upperbound;
+            }
+            *pen = val;
+            Highs_changeColBounds (lp->h, col, lower, upper);
+            if (Highs_setBasis (lp->h, cs, rs) == kHighsStatusError) {
+                fprintf (stderr, "Highs_setBasis failed\n");
+                rval = 1; goto CLEANUP;
+            }
+        }
+    }
+
+CLEANUP:
+
+    CC_IFFREE (cs, HighsInt);
+    CC_IFFREE (rs, HighsInt);
+    return rval;
+}
