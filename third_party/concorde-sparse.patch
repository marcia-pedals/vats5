+    for (i = 0; i < ncount; i++) {
+        deg = dat->degree[i];
+        if (deg < 2) continue;
+        for (j = 0; j < deg; j++) {
+            buf[j].nbr = dat->adj[i][j];
+            buf[j].len = dat->len[i][j];
+        }
+        qsort (buf, deg, sizeof (sparse_adjpair), sparse_adjpair_cmp);
+        for (j = 0; j < deg; j++) {
+            dat->adj[i][j] = buf[j].nbr;
+            dat->len[i][j] = buf[j].len;
+        }
+    }
+    CC_FREE (buf, sparse_adjpair);
+    return 0;
+}
