+
+CLEANUP:
+
+    CC_IFFREE (rlower, double);
+    CC_IFFREE (rupper, double);
+    CC_IFFREE (astart, HighsInt);
+    CC_IFFREE (aindex, HighsInt);
+    CC_IFFREE (avalue, double);
+    return rval;
+}
+
+int CClp_create (CClp *lp, const char *name)
+{
+    (void) name;
+    if (!lp) {
+        fprintf (stderr, "CClp_create called without an lp structure\n");
+        return 1;
+    }
+    return new_highs (lp);
+}
+
+int CClp_new_row (CClp *lp, char sense, double rhs)
+{
+    double lower, upper;
+
+    if (sense_to_bounds (sense, rhs, &lower, &upper)) return 1;
+    if (Highs_addRow (lp->h, lower, upper, 0, (HighsInt *) NULL,
+                      (double *) NULL) == kHighsStatusError) {
+        fprintf (stderr, "Highs_addRow failed\n");
+        return 1;
+    }
+    return 0;
+}
+
+int CClp_change_sense (CClp *lp, int row, char sense)
+{
+    HighsInt num_row, num_nz;
+    double lower, upper, rhs;
+
+    if (Highs_getRowsByRange (lp->h, row, row, &num_row, &lower, &upper,
+                              &num_nz, (HighsInt *) NULL, (HighsInt *) NULL,
+                              (double *) NULL) == kHighsStatusError) {
+        fprintf (stderr, "Highs_getRowsByRange failed\n");
+        return 1;
+    }
+    rhs = (lower > -HIGHS_INFINITY / 2) ? lower : upper;
+    if (sense_to_bounds (sense, rhs, &lower, &upper)) return 1;
+    if (Highs_changeRowBounds (lp->h, row, lower, upper) == kHighsStatusError) {
+        fprintf (stderr, "Highs_changeRowBounds failed\n");
+        return 1;
+    }
+    return 0;
+}
+
+static int run_simplex (CClp *lp, int strategy, int iteration_limit,
+        int *model_status)
+{
+    HighsInt status;
+
+    Highs_setIntOptionValue (lp->h, "simplex_strategy", strategy);
+    Highs_setIntOptionValue (lp->h, "simplex_iteration_limit",
+                             iteration_limit);
+    status = Highs_run (lp->h);
+    *model_status = Highs_getModelStatus (lp->h);
+    if (status == kHighsStatusError) {
+        fprintf (stderr, "Highs_run failed (model status %d)\n",
+                 *model_status);
+        return 1;
+    }
+    return 0;
+}
+
+int CClp_opt (CClp *lp, int method)
+{
+    int rval, model_status, strategy;
+
+    switch (method) {
+    case CClp_METHOD_PRIMAL:  strategy = 4; break;
+    case CClp_METHOD_DUAL:    strategy = 1; break;
+    case CClp_METHOD_BARRIER:
+        fprintf (stderr, "barrier not used with the HiGHS interface\n");
+        return 1;
+    default:
+        fprintf (stderr, "Nonexistent method in CClp_opt\n");
+        return 1;
+    }
+
+    rval = run_simplex (lp, strategy, HIGHS_ITER_UNLIMITED, &model_status);
+    if (rval) return rval;
+
+    /* Concorde's LPs have bounded variables, so "unbounded or infeasible"
+       means infeasible (HiGHS reports it when the dual simplex proves dual
+       unboundedness without a primal phase). */
+    if (model_status == kHighsModelStatusInfeasible ||
+        model_status == kHighsModelStatusUnboundedOrInfeasible) {
+        return 2;
+    } else if (model_status != kHighsModelStatusOptimal) {
+        fprintf (stderr, "no optimal LP-solution exists: HiGHS status %d\n",
+                 model_status);
+        return 1;
+    }
+    return 0;
+}
+
+int CClp_limited_dualopt (CClp *lp, int iterationlim, int *status,
+        double *objupperlim)
+{
+    int rval, model_status;
+
+    (void) objupperlim;
+
+    rval = run_simplex (lp, 1, iterationlim, &model_status);
+    if (rval) return rval;
+
+    if (status) {
+        if (model_status == kHighsModelStatusInfeasible ||
+            model_status == kHighsModelStatusUnboundedOrInfeasible) {
+            *status = CClp_INFEASIBLE;
+        } else if (model_status == kHighsModelStatusUnbounded) {
+            *status = CClp_UNBOUNDED;
+        } else if (model_status == kHighsModelStatusOptimal ||
+                   model_status == kHighsModelStatusIterationLimit) {
+            *status = CClp_SUCCESS;
+        } else {
+            fprintf (stderr, "no optimal LP-solution exists: HiGHS status %d\n",
+                     model_status);
+            *status = CClp_FAILURE;
+        }
+    }
+    return 0;
+}
+
+int CClp_addrows (CClp *lp, int newrows, int newnz, double *rhs, char *sense,
+        int *rmatbeg, int *rmatind, double *rmatval)
+{
+    int rval = 0, i;
+    double *lower = (double *) NULL, *upper = (double *) NULL;
+
+    lower = CC_SAFE_MALLOC (newrows, double);
+    upper = CC_SAFE_MALLOC (newrows, double);
+    if (!lower || !upper) {
+        fprintf (stderr, "out of memory in CClp_addrows\n");
+        rval = 1; goto CLEANUP;
+    }
+    for (i = 0; i < newrows; i++) {
+        rval = sense_to_bounds (sense[i], rhs[i], &lower[i], &upper[i]);
+        if (rval) goto CLEANUP;
+    }
+    if (Highs_addRows (lp->h, newrows, lower, upper, newnz, rmatbeg, rmatind,
+                       rmatval) == kHighsStatusError) {
+        fprintf (stderr, "Highs_addRows failed\n");
+        rval = 1; goto CLEANUP;
+    }
+
+CLEANUP:
+
+    CC_IFFREE (lower, double);
+    CC_IFFREE (upper, double);
+    return rval;
+}
+
+int CClp_addcols (CClp *lp, int newcols, int newnz, double *obj,
+        int *cmatbeg, int *cmatind, double *cmatval, double *lb, double *ub)
+{
+    if (Highs_addCols (lp->h, newcols, obj, lb, ub, newnz, cmatbeg, cmatind,
+                       cmatval) == kHighsStatusError) {
+        fprintf (stderr, "Highs_addCols failed\n");
+        return 1;
+    }
+    return 0;
+}
