+    for (i = 0, nz = 0; i < ncols; i++) {
+        astart[i] = nz;
+        for (k = 0; k < matcnt[i]; k++) {
+            aindex[nz] = matind[matbeg[i] + k];
+            avalue[nz] = matval[matbeg[i] + k];
+            nz++;
+        }
+    }
+    astart[ncols] = nz;
+
+    if (Highs_passLp (lp->h, ncols, nrows, nz, kHighsMatrixFormatColwise,
+                      objsense >= 0 ? kHighsObjSenseMinimize
+                                    : kHighsObjSenseMaximize,
+                      0.0, obj, lb, ub, rlower, rupper, astart, aindex,
+                      avalue) == kHighsStatusError) {
+        fprintf (stderr, "Highs_passLp failed\n");
+        rval = 1; goto CLEANUP;
